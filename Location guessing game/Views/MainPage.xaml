<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Location_guessing_game.Views.MainPage"
             Title="MainPage">
    <Grid RowDefinitions="Auto, *, Auto" Padding="20">

        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="End" Margin="0,10,0,0">
            <Button Text="Log Out" 
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="Transparent"
                    TextColor="Red"
                    FontAttributes="Bold"
                    FontSize="14" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="20" VerticalOptions="Center" HorizontalOptions="Center">

            <Label Text="Location Guesser" 
                   FontSize="36" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"
                   Margin="0,0,0,30" />

            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="Selected location set:" 
                       FontSize="14" 
                       TextColor="Gray" 
                       HorizontalOptions="Center" />

                <Label Text="{Binding SelectedImageList.Name, TargetNullValue='No set selected'}" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Button Text="Play"
                    Command="{Binding StartGameCommand}"
                    FontSize="22"
                    FontAttributes="Bold"
                    CornerRadius="30"
                    WidthRequest="200"
                    HeightRequest="60"
                    Margin="0,20,0,0" />

            <Button Text="Select list of locations"
                    Command="{Binding GoToSelectionCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    BorderColor="{StaticResource Primary}"
                    BorderWidth="2"
                    CornerRadius="25"
                    WidthRequest="250"
                    HeightRequest="50" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>