<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Location_guessing_game.Views.ListLeaderboardPage"
             Title="{Binding ListName}">

    <VerticalStackLayout Padding="20">
        <Label Text="Best results" FontSize="24" HorizontalOptions="Center" Margin="0,0,0,20"/>

        <CollectionView ItemsSource="{Binding Leaderboard}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*, Auto, Auto" Padding="10">
                        <Label Grid.Column = "0" Text="{Binding UserName}" VerticalOptions="Center"/>
                        <Label Grid.Column = "1" Text="{Binding Score}" FontAttributes="Bold" Margin="20,0" VerticalOptions="Center"/>
                        <Label Grid.Column = "2" Text="{Binding PlayedAt, StringFormat='{0:dd.MM.yyyy}'}" FontSize="12" VerticalOptions="Center"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentPage>