<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Location_guessing_game.Views.GamePage"
             Title="GamePage"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui">
    <Grid RowDefinitions="Auto, *">
        <Button Grid.Row="0" 
                Text="Go Back" 
                Command="{Binding GoBackCommand}" 
                HorizontalOptions="Center" />
        <Grid Grid.Row="1">
            <Image Source="{Binding CurrentImage.ImageSource}" Aspect="AspectFill" />

            <Grid x:Name="MapGuessGrid" 
                  VerticalOptions="End" 
                  HorizontalOptions="End" 
                  Margin="20" 
                  RowDefinitions="*, Auto"
                  ColumnDefinitions="200">

                <Button Grid.Row="1"
                        Text="Guess!"
                        Command="{Binding GuessCommand}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontSize="20"
                        Padding="40, 15"
                        Margin="10"/>
                <Border Grid.Column="0" 
                        x:Name="MapContainer" 
                        StrokeShape="RoundRectangle 10" 
                        StrokeThickness="2">
                    <Grid>
                        <mapsui:MapControl  x:Name="Map"
                                            BackgroundColor="White" />

                        <Button x:Name="ChangeMapSizeButton"
                                Text="⤢" 
                                Clicked="ToggleMapSize_Clicked"
                                WidthRequest="40" 
                                HeightRequest="40"
                                HorizontalOptions="Start" 
                                VerticalOptions="Start"
                                Margin="5"
                                Padding="0"
                                CornerRadius="20"
                                Opacity="0.8" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>