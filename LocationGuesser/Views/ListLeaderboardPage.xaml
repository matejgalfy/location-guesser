<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocationGuesser.Views.ListLeaderboardPage"
             Title="">

    <VerticalStackLayout Padding="20">
        <Label Text="{Binding ListName, StringFormat='{0} - best results'}" FontSize="24" HorizontalOptions="Center" Margin="0,0,0,20"/>

        <CollectionView ItemsSource="{Binding Leaderboard}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 10" 
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="2"
                            Padding="15" 
                            Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <Label Grid.Column = "0" Text="{Binding UserName}" VerticalOptions="Center"/>
                            <Label Grid.Column = "1" Text="{Binding Score}" FontAttributes="Bold" Margin="20,0" VerticalOptions="Center"/>
                            <Label Grid.Column = "2" Text="{Binding PlayedAt, StringFormat='{0:dd.MM.yyyy}'}" FontSize="12" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentPage>